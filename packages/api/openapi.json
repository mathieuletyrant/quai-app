      "get": {
        "tags": [
          "system"
        ],
        "operationId": "system.health",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "post": {
        "tags": [
          "devices"
        ],
        "operationId": "devices.pair",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "PairedDevice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairedDevice"
                }
              }
            }
          },
          "403": {
            "description": "InvalidPairingCode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidPairingCodeEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairDevice"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/devices/me": {
      "patch": {
        "tags": [
          "devices"
        ],
        "operationId": "devices.update",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "<No Content>"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDevice"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/devices/me/activity-tokens": {
      "post": {
        "tags": [
          "devices"
        ],
        "operationId": "devices.activityToken",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "<No Content>"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivityToken"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/activities": {
      "get": {
        "tags": [
          "devices"
        ],
        "operationId": "devices.activities",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RunningActivity"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        }
      }
    },
    "/console-api/pairing-codes": {
      "post": {
        "tags": [
          "console"
        ],
        "operationId": "console.createPairingCode",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "PairingCode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingCode"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "serverUrls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "serverUrls"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/console-api/devices": {
      "get": {
        "tags": [
          "console"
        ],
        "operationId": "console.devices",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
