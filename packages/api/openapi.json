  "components": {
    "schemas": {
      "effect_HttpApiError_NotFoundEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "NotFound"
            ]
          }
        },
        "required": [
          "_tag"
        ],
        "additionalProperties": false
      },
      "Flow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "builtIn": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "color": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "subject": {
            "$ref": "#/components/schemas/FlowSubject"
          },
          "filter": {
            "$ref": "#/components/schemas/FlowFilter"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlowStep"
            },
            "minItems": 1,
            "maxItems": 6
          },
          "endOn": {
            "$ref": "#/components/schemas/EventType"
          },
          "lingerMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60
          },
          "stalledAfterMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "expireAfterMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          }
        },
        "required": [
          "id",
          "name",
          "builtIn",
          "enabled",
          "color",
          "icon",
          "subject",
          "filter",
          "steps",
          "lingerMinutes"
        ],
        "additionalProperties": false
      },
      "EventType": {
        "type": "string",
        "enum": [
          "media.added",
          "media.grabbed",
          "media.imported",
          "media.available",
          "download.progress",
          "playback.started",
          "playback.progress",
          "playback.stopped",
          "service.down",
          "service.up"
        ]
      },
      "FlowStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "icon": {
            "type": "string"
          },
          "on": {
            "$ref": "#/components/schemas/EventType"
          },
          "show": {
            "$ref": "#/components/schemas/StepShow"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionType"
            }
          }
        },
        "required": [
          "id",
          "label",
          "icon",
          "on",
          "show"
        ],
        "additionalProperties": false
      },
      "ActionType": {
        "type": "string",
        "enum": [
          "playback.playPause",
          "playback.stop"
        ]
      },
      "StepShow": {
        "type": "object",
        "properties": {
          "progress": {
            "type": "boolean"
          },
          "speed": {
            "type": "boolean"
          },
          "eta": {
            "type": "boolean"
          },
          "timer": {
            "type": "boolean"
          },
          "since": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "FlowFilter": {
        "type": "object",
        "properties": {
          "mediaType": {
            "type": "string",
            "enum": [
              "any",
              "movie",
              "series"
            ]
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "FlowSubject": {
        "type": "string",
        "enum": [
          "media",
          "playback",
          "service"
        ]
      },
      "InvalidFlowEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "InvalidFlow"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "message"
        ],
        "additionalProperties": false
      },
      "CatalogAction": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ActionType"
          },
          "subject": {
            "$ref": "#/components/schemas/FlowSubject"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "subject",
          "label"
        ],
        "additionalProperties": false
      },
      "CatalogEvent": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "subject": {
            "$ref": "#/components/schemas/FlowSubject"
          },
          "label": {
            "type": "string"
          },
          "data": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "subject",
          "label",
          "data"
        ],
        "additionalProperties": false
      },
      "PushSettings": {
        "type": "object",
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "console",
              "environment"
            ]
          },
          "keyId": {
            "type": "string"
          },
          "teamId": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        },
        "required": [
          "configured",
          "topic"
        ],
        "additionalProperties": false
      },
      "InvalidPushKeyEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "InvalidPushKey"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "message"
        ],
        "additionalProperties": false
      },
      "SavePushKey": {
        "type": "object",
        "properties": {
          "keyPem": {
            "type": "string"
          },
          "keyId": {
            "type": "string"
          },
          "teamId": {
            "type": "string"
          }
        },
        "required": [
