{
  "openapi": "3.1.0",
  "info": {
    "title": "Api",
    "version": "0.0.1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "system.health",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "uptimeSeconds": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "uptimeSeconds"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "post": {
        "tags": [
          "devices"
        ],
        "operationId": "devices.pair",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deviceId": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "deviceId",
                    "token"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "InvalidPairingCode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidPairingCodeEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "apnsEnvironment": {
                    "type": "string",
                    "enum": [
                      "development",
                      "production"
                    ]
                  },
                  "pushToStartToken": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "code",
                  "name",
                  "apnsEnvironment",
                  "pushToStartToken"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/devices/me": {
      "patch": {
        "tags": [
          "devices"
        ],
        "operationId": "devices.update",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "<No Content>"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "pushToStartToken": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/devices/me/activity-tokens": {
      "post": {
        "tags": [
          "devices"
        ],
        "operationId": "devices.activityToken",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "<No Content>"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mediaKey": {
                    "type": "string"
                  },
                  "pushToken": {
                    "type": "string"
                  }
                },
                "required": [
                  "mediaKey",
                  "pushToken"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/activities": {
      "get": {
        "tags": [
          "devices"
        ],
        "operationId": "devices.activities",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "attributes": {
                        "type": "object",
                        "properties": {
                          "mediaKey": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "mediaKey",
                          "title"
                        ],
                        "additionalProperties": false
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "step": {
                            "type": "string",
                            "enum": [
                              "searching",
                              "downloading",
                              "importing",
                              "available"
                            ]
                          },
                          "progress": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "bytesPerSecond": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "remainingSeconds": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "stalled": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "step",
                          "progress",
                          "bytesPerSecond",
                          "remainingSeconds",
                          "stalled"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "attributes",
                      "content"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/effect_HttpApiError_UnauthorizedEncoded"
                }
              }
            }
          }
        }
      }
    },
    "/console-api/pairing-codes": {
      "post": {
        "tags": [
          "console"
        ],
        "operationId": "console.createPairingCode",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "link": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "expiresAt",
                    "link"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "serverUrls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "serverUrls"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/console-api/devices": {
      "get": {
        "tags": [
          "console"
        ],
        "operationId": "console.devices",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "apnsEnvironment": {
                        "type": "string",
                        "enum": [
                          "development",
                          "production"
                        ]
                      },
                      "canStartActivities": {
                        "type": "boolean"
                      },
                      "pairedAt": {
                        "type": "string"
                      },
                      "lastSeenAt": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "apnsEnvironment",
                      "canStartActivities",
                      "pairedAt",
                      "lastSeenAt"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
