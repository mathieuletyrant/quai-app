  "components": {
    "schemas": {
      "effect_HttpApiError_NotFoundEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "NotFound"
            ]
          }
        },
        "required": [
          "_tag"
        ],
        "additionalProperties": false
      },
      "DeviceSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "apnsEnvironment": {
            "$ref": "#/components/schemas/ApnsEnvironment"
          },
          "canStartActivities": {
            "type": "boolean"
          },
          "pairedAt": {
            "type": "string"
          },
          "lastSeenAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "apnsEnvironment",
          "canStartActivities",
          "pairedAt"
        ],
        "additionalProperties": false
      },
      "ApnsEnvironment": {
        "type": "string",
        "enum": [
          "development",
          "production"
        ]
      },
      "PairingCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "link": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "expiresAt",
          "link"
        ],
        "additionalProperties": false
      },
      "effect_HttpApiError_UnauthorizedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "Unauthorized"
            ]
          }
        },
        "required": [
          "_tag"
        ],
        "additionalProperties": false
      },
      "RunningActivity": {
        "type": "object",
        "properties": {
          "attributes": {
            "$ref": "#/components/schemas/DownloadAttributes"
          },
          "content": {
            "$ref": "#/components/schemas/DownloadContentState"
          }
        },
        "required": [
          "attributes",
          "content"
        ],
        "additionalProperties": false
      },
      "DownloadContentState": {
        "type": "object",
        "properties": {
          "step": {
            "$ref": "#/components/schemas/DownloadStep"
          },
          "progress": {
            "type": "number"
          },
          "bytesPerSecond": {
            "type": "number"
          },
          "remainingSeconds": {
            "type": "number"
          },
          "stalled": {
            "type": "boolean"
          }
        },
        "required": [
          "step",
          "stalled"
        ],
        "additionalProperties": false
      },
      "DownloadStep": {
        "type": "string",
        "enum": [
          "searching",
          "downloading",
          "importing",
          "available"
        ]
      },
      "DownloadAttributes": {
        "type": "object",
        "properties": {
          "mediaKey": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "mediaKey",
          "title"
        ],
        "additionalProperties": false
      },
      "ActivityToken": {
        "type": "object",
        "properties": {
          "mediaKey": {
            "type": "string"
          },
          "pushToken": {
            "type": "string"
          }
        },
        "required": [
          "mediaKey",
          "pushToken"
        ],
        "additionalProperties": false
      },
      "UpdateDevice": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "pushToStartToken": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "InvalidPairingCodeEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "InvalidPairingCode"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "message"
        ],
        "additionalProperties": false
      },
      "PairedDevice": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "deviceId",
          "token"
        ],
        "additionalProperties": false
      },
      "PairDevice": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "apnsEnvironment": {
            "$ref": "#/components/schemas/ApnsEnvironment"
          },
          "pushToStartToken": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "apnsEnvironment"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          },
          "uptimeSeconds": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "version",
          "uptimeSeconds"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "system"
    },
    {
      "name": "devices"
    },
    {
      "name": "console"
    }
  ]
}
