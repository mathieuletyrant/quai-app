{
  "name": "quai",
  "version": "2.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check && pnpm lint",
    "test": "pnpm -r test",
    "bench": "pnpm --filter @quai/cloud bench",
    "dev:cloud": "pnpm --filter @quai/cloud dev",
    "dev:home": "pnpm --filter @quai/home dev",
    "dev:console": "pnpm --filter @quai/console dev",
    "gen:openapi": "pnpm --filter @quai/api gen:openapi",
    "gen:client": "apps/ios/scripts/gen-client.sh",
    "lint": "eslint .",
    "format": "eslint . --fix"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "0.3.2",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.3",
    "globals": "^16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
